+    public static File createMarkdownCopy(File source) throws IOException {
+        if (source == null || !source.isFile() || !isSubtitle(source)) {
+            throw new IOException("字幕文件不可用");
+        }
+        String fileName = source.getName();
+        int dot = fileName.lastIndexOf('.');
+        String baseName = dot > 0 ? fileName.substring(0, dot) : fileName;
+        File markdownFile = new File(source.getParentFile(), baseName + ".md");
+        int suffix = 2;
+        while (markdownFile.exists()) {
+            markdownFile = new File(source.getParentFile(), baseName + "-" + suffix + ".md");
+            suffix++;
+        }
+
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(
+                     new FileInputStream(source), StandardCharsets.UTF_8));
+             Writer writer = new OutputStreamWriter(
+                     new FileOutputStream(markdownFile), StandardCharsets.UTF_8)) {
+            writer.write("# 字幕文本\n\n");
+            writer.write("> 由本地字幕工坊生成，保留时间轴，便于在 ChatGPT 等应用中分析。\n\n");
+            String timeRange = "";
+            StringBuilder text = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                String trimmed = line.trim();
+                if (trimmed.equalsIgnoreCase("WEBVTT")) {
+                    continue;
+                }
+                if (trimmed.contains("-->")) {
+                    writeMarkdownBlock(writer, timeRange, text);
+                    timeRange = trimmed.replace("-->", "→");
+                } else if (trimmed.isEmpty()) {
+                    writeMarkdownBlock(writer, timeRange, text);
+                    timeRange = "";
+                } else if (!(timeRange.isEmpty() && trimmed.matches("\\d+"))) {
+                    if (text.length() > 0) text.append("  \n");
+                    text.append(trimmed);
+                }
+            }
+            writeMarkdownBlock(writer, timeRange, text);
+        } catch (IOException error) {
+            markdownFile.delete();
+            throw error;
+        }
+        return markdownFile;
+    }
+
+    private static void writeMarkdownBlock(Writer writer, String timeRange,
+                                           StringBuilder text) throws IOException {
+        if (text.length() == 0) return;
+        if (timeRange != null && !timeRange.isEmpty()) {
+            writer.write("## " + timeRange + "\n\n");
         }
+        writer.write(text.toString());
+        writer.write("\n\n");
+        text.setLength(0);
     }
 
