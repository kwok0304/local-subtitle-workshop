+package com.serhat.autosub.ui.generate;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.webkit.CookieManager;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+
+import androidx.core.content.FileProvider;
+
+import com.arthenica.ffmpegkit.FFmpegKit;
+import com.arthenica.ffmpegkit.FFmpegSession;
+import com.arthenica.ffmpegkit.ReturnCode;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Resolves a public Douyin page inside Android WebView, downloads its DASH video/audio
+ * resources, then uses the app's bundled FFmpeg to create an ordinary MP4.
+ */
+public final class DouyinWebImporter {
+    private static final Pattern SHARED_URL = Pattern.compile("https?://[^\\s]+", Pattern.CASE_INSENSITIVE);
+    private static final Pattern AWEME_ID = Pattern.compile("(?:video/|modal_id=)(\\d{15,20})");
+    private static final long RESOLVE_TIMEOUT_MS = 120_000L;
+    private static final long POLL_INTERVAL_MS = 1_500L;
+    private static final int CONNECT_TIMEOUT_MS = 20_000;
+    private static final int READ_TIMEOUT_MS = 60_000;
+    private static final String DESKTOP_USER_AGENT =
+            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+                    + "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36";
+
+    public interface Callback {
+        void onProgress(String message, int percent);
+        void onSuccess(Uri videoUri);
+        void onError(String message);
+    }
+
+    private final Context context;
+    private final WebView webView;
+    private final Callback callback;
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private final AtomicBoolean cancelled = new AtomicBoolean(false);
+    private String sourcePageUrl = "https://www.douyin.com/";
+    private String cookieHeader = "";
+    private String bestVideoUrl;
+    private String bestAudioUrl;
+    private int bestVideoRate = -1;
+    private int bestAudioRate = -1;
+    private long startedAt;
+    private boolean downloadStarted;
+    private boolean disposed;
+    private volatile HttpURLConnection activeConnection;
+
+    public DouyinWebImporter(Context context, WebView webView, Callback callback) {
+        this.context = context.getApplicationContext();
+        this.webView = webView;
+        this.callback = callback;
+        configureWebView();
+    }
+
+    public void start(String sharedText) {
+        String url;
+        try {
+            url = extractUrl(sharedText);
+        } catch (Exception error) {
+            fail(error.getMessage());
+            return;
+        }
+        startedAt = android.os.SystemClock.elapsedRealtime();
+        callback.onProgress("正在打开抖音作品页…", -1);
+        webView.loadUrl(url);
+        mainHandler.postDelayed(this::pollMediaResources, POLL_INTERVAL_MS);
+    }
+
+    public void cancel() {
+        if (!cancelled.compareAndSet(false, true)) return;
+        dispose();
+    }
+
+    private void dispose() {
+        if (disposed) return;
+        disposed = true;
+        mainHandler.removeCallbacksAndMessages(null);
+        HttpURLConnection connection = activeConnection;
+        if (connection != null) connection.disconnect();
+        executor.shutdownNow();
+        webView.stopLoading();
+        webView.destroy();
+    }
+
+    private void configureWebView() {
+        WebSettings settings = webView.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        settings.setDatabaseEnabled(true);
+        settings.setUseWideViewPort(true);
+        settings.setLoadWithOverviewMode(true);
+        settings.setMediaPlaybackRequiresUserGesture(false);
+        settings.setUserAgentString(DESKTOP_USER_AGENT);
+        settings.setLoadsImagesAutomatically(true);
+        settings.setAllowFileAccess(false);
+        settings.setAllowContentAccess(false);
+        CookieManager.getInstance().setAcceptCookie(true);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(webView, true);
+        webView.addJavascriptInterface(new ResourceBridge(), "LocalSubtitleBridge");
+        webView.setWebChromeClient(new WebChromeClient());
+        webView.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                return false;
+            }
+
+            @Override
+            public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
+                String resource = request.getUrl() == null ? "" : request.getUrl().toString();
+                if (isMediaCandidate(resource)) {
+                    mainHandler.post(() -> handleResourceCandidate(resource));
+                }
+                return super.shouldInterceptRequest(view, request);
+            }
+
+            @Override
+            public void onPageFinished(WebView view, String url) {
+                sourcePageUrl = url == null ? sourcePageUrl : url;
+                callback.onProgress("作品页已打开，正在识别视频资源…", -1);
+                collectPerformanceResources();
+            }
+        });
+    }
+
+    private void pollMediaResources() {
+        if (cancelled.get() || downloadStarted) return;
+        if (android.os.SystemClock.elapsedRealtime() - startedAt > RESOLVE_TIMEOUT_MS) {
+            fail("解析超时。请确认链接是公开的单个视频，并稍后重试。");
+            return;
+        }
+        collectPerformanceResources();
+        mainHandler.postDelayed(this::pollMediaResources, POLL_INTERVAL_MS);
+    }
+
+    private void collectPerformanceResources() {
+        if (cancelled.get() || downloadStarted) return;
+        String script = "(function(){try{" +
+                "document.querySelectorAll('video').forEach(function(v){v.muted=true;" +
+                "var p=v.play();if(p&&p.catch)p.catch(function(){});});" +
+                "window.scrollTo(0,Math.max(0,document.body.scrollHeight/3));" +
+                "var xs=performance.getEntriesByType('resource').map(function(e){return e.name;})" +
+                ".filter(function(u){return /douyinvod|media-video|media-audio|mime_type=video_mp4/i.test(u);});" +
+                "LocalSubtitleBridge.onResources(JSON.stringify({page:location.href,items:xs}));" +
+                "}catch(e){}})();";
+        webView.evaluateJavascript(script, null);
+    }
+
+    private final class ResourceBridge {
+        @JavascriptInterface
+        public void onResources(String json) {
+            mainHandler.post(() -> handleResources(json));
+        }
+    }
+
+    private void handleResources(String json) {
+        if (cancelled.get() || downloadStarted || json == null || json.isEmpty()) return;
+        try {
+            JSONObject payload = new JSONObject(json);
+            sourcePageUrl = payload.optString("page", sourcePageUrl);
+            JSONArray items = payload.optJSONArray("items");
+            if (items == null) return;
+            for (int index = 0; index < items.length(); index++) {
+                handleResourceCandidate(items.optString(index, ""));
+            }
+        } catch (Exception ignored) {
+            // A partially loaded page may produce incomplete data. The next poll retries.
+        }
+    }
+
+    private void handleResourceCandidate(String resource) {
+        if (cancelled.get() || downloadStarted || !isMediaCandidate(resource)) return;
+        int rate = queryInt(resource, "br");
+        if (resource.contains("media-video") && rate >= bestVideoRate) {
+            bestVideoUrl = resource;
+            bestVideoRate = rate;
+        } else if (resource.contains("media-audio") && rate >= bestAudioRate) {
+            bestAudioUrl = resource;
+            bestAudioRate = rate;
+        }
+        if (bestVideoUrl == null || bestAudioUrl == null) return;
+
+        downloadStarted = true;
+        mainHandler.removeCallbacksAndMessages(null);
+        String cookies = CookieManager.getInstance().getCookie(sourcePageUrl);
+        cookieHeader = cookies == null ? "" : cookies;
+        String videoUrl = bestVideoUrl;
+        String audioUrl = bestAudioUrl;
+        callback.onProgress("已找到视频，准备下载…", 0);
+        executor.execute(() -> downloadAndMux(videoUrl, audioUrl));
+    }
+
+    private static boolean isMediaCandidate(String resource) {
+        return resource != null && (resource.contains("media-video")
+                || resource.contains("media-audio"));
+    }
+
+    private void downloadAndMux(String videoUrl, String audioUrl) {
+        File videoPart = null;
+        File audioPart = null;
+        try {
+            ensureNotCancelled();
+            String awemeId = extractAwemeId(sourcePageUrl);
+            File outputDir = new File(context.getFilesDir(), "douyin_imports");
+            if (!outputDir.exists() && !outputDir.mkdirs()) {
+                throw new IllegalStateException("无法创建手机视频目录");
+            }
+            videoPart = new File(outputDir, "video_" + awemeId + ".m4v.part");
+            audioPart = new File(outputDir, "audio_" + awemeId + ".m4a.part");
+            File output = new File(outputDir, "douyin_" + awemeId + ".mp4");
+
+            downloadResource(videoUrl, videoPart, "正在下载画面", 0, 82);
+            downloadResource(audioUrl, audioPart, "正在下载声音", 82, 95);
+            ensureNotCancelled();
+            postProgress("正在合并视频和声音…", 96);
+            if (output.exists() && !output.delete()) {
+                throw new IllegalStateException("无法替换旧视频");
+            }
+            String command = String.format(Locale.US,
+                    "-y -i %s -i %s -map 0:v:0 -map 1:a:0 -c copy -movflags +faststart %s",
+                    quote(videoPart), quote(audioPart), quote(output));
+            FFmpegSession session = FFmpegKit.execute(command);
+            if (!ReturnCode.isSuccess(session.getReturnCode()) || !output.isFile() || output.length() == 0) {
+                throw new IllegalStateException("合并视频失败：" + session.getLogsAsString());
+            }
+            ensureNotCancelled();
+            Uri uri = FileProvider.getUriForFile(
+                    context, context.getPackageName() + ".provider", output);
+            mainHandler.post(() -> {
+                callback.onSuccess(uri);
+                dispose();
+            });
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+        } catch (Exception error) {
+            if (!cancelled.get()) {
+                String message = error.getMessage();
+                mainHandler.post(() -> fail(
+                        message == null || message.isEmpty() ? "抖音视频下载失败" : message));
+            }
+        } finally {
+            if (videoPart != null) videoPart.delete();
+            if (audioPart != null) audioPart.delete();
+            activeConnection = null;
+        }
+    }
+
+    private void downloadResource(String target, File destination, String label,
+                                  int startPercent, int endPercent) throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL(target).openConnection();
+        activeConnection = connection;
+        connection.setConnectTimeout(CONNECT_TIMEOUT_MS);
+        connection.setReadTimeout(READ_TIMEOUT_MS);
+        connection.setRequestProperty("User-Agent", DESKTOP_USER_AGENT);
+        connection.setRequestProperty("Referer", sourcePageUrl);
+        if (!cookieHeader.isEmpty()) connection.setRequestProperty("Cookie", cookieHeader);
+        int code = connection.getResponseCode();
+        if (code < 200 || code >= 300) {
+            connection.disconnect();
+            throw new IllegalStateException(label + "失败（HTTP " + code + "）");
+        }
+        long total = connection.getContentLengthLong();
+        long received = 0;
+        try (InputStream input = new BufferedInputStream(connection.getInputStream());
+             BufferedOutputStream output = new BufferedOutputStream(new FileOutputStream(destination))) {
+            byte[] buffer = new byte[128 * 1024];
+            int read;
+            while ((read = input.read(buffer)) != -1) {
+                ensureNotCancelled();
+                output.write(buffer, 0, read);
+                received += read;
+                int progress = total > 0
+                        ? startPercent + (int) Math.min(endPercent - startPercent,
+                        received * (endPercent - startPercent) / total)
+                        : startPercent;
+                postProgress(label + (total > 0 ? "：" + progress + "%" : "…"), progress);
+            }
+        } finally {
+            connection.disconnect();
+            activeConnection = null;
+        }
+        if (!destination.isFile() || destination.length() == 0) {
+            throw new IllegalStateException(label + "得到空文件");
+        }
+    }
+
+    private void postProgress(String message, int percent) {
+        mainHandler.post(() -> callback.onProgress(message, percent));
+    }
+
+    private void fail(String message) {
+        if (disposed || cancelled.get()) return;
+        callback.onError(message == null || message.isEmpty() ? "抖音视频解析失败" : message);
+        dispose();
+    }
+
+    private void ensureNotCancelled() throws InterruptedException {
+        if (cancelled.get() || Thread.currentThread().isInterrupted()) {
+            throw new InterruptedException("cancelled");
+        }
+    }
+
+    static String extractUrl(String text) {
+        Matcher matcher = SHARED_URL.matcher(text == null ? "" : text.trim());
+        if (!matcher.find()) throw new IllegalArgumentException("没有找到有效的抖音分享链接");
+        String url = matcher.group();
+        while (url.endsWith("。") || url.endsWith("，") || url.endsWith(",")
+                || url.endsWith(":") || url.endsWith("；") || url.endsWith(";")) {
+            url = url.substring(0, url.length() - 1);
+        }
+        return url;
+    }
+
+    private static String extractAwemeId(String url) {
+        Matcher matcher = AWEME_ID.matcher(url == null ? "" : url);
+        return matcher.find() ? matcher.group(1) : String.valueOf(System.currentTimeMillis());
+    }
+
+    private static int queryInt(String url, String key) {
+        try {
+            String query = new URL(url).getQuery();
+            if (query == null) return -1;
+            for (String pair : query.split("&")) {
+                String[] parts = pair.split("=", 2);
+                if (parts.length == 2 && key.equals(parts[0])) return Integer.parseInt(parts[1]);
+            }
+        } catch (Exception ignored) {
+        }
+        return -1;
+    }
+
+    private static String quote(File file) {
+        return "\"" + file.getAbsolutePath().replace("\"", "\\\"") + "\"";
+    }
+}
